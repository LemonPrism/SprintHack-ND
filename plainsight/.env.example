# Copy this file to .env and fill in a key. .env is git-ignored.
PLAINSIGHT_PROVIDER=anthropic
# Confirm the current model string in Anthropic's docs. Examples: a Sonnet-class
# model for quality, a Haiku-class model for cheap/fast iteration.
PLAINSIGHT_MODEL=claude-sonnet-5-5
PLAINSIGHT_TEMPERATURE=0.0
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# OPENAI_API_KEY=sk-REPLACE_ME
