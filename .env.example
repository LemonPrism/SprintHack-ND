# Copy this file to .env and fill it in. .env is git-ignored.

# --- Option A: local & free (Ollama, no API key) -----------------------------
# Install Ollama, then: ollama pull qwen2.5:7b
PLAINSIGHT_PROVIDER=ollama
PLAINSIGHT_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# --- Option B: Claude via the Claude Code CLI (your subscription, no API key) --
# Requires the `claude` CLI installed and logged in (run `claude` once).
# Stronger, more creative Stage 1 covers and reliable arbitrary themes/personas.
# PLAINSIGHT_PROVIDER=claude-cli
# PLAINSIGHT_MODEL=sonnet                 # CLI alias: sonnet | opus
# PLAINSIGHT_CLAUDE_BIN=                  # optional: path to the claude binary

# --- Option C: cloud (Anthropic API, needs a paid API key) -------------------
# PLAINSIGHT_PROVIDER=anthropic
# PLAINSIGHT_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Option D: xAI Grok (OpenAI-compatible API, paid per-token) --------------
# No subscription/CLI route — needs a paid key from console.x.ai (promo credits
# may apply). Useful for Stage 1: Grok is less likely to refuse disguising the
# secret than a frontier model. Confirm the current model id in the xAI docs.
# PLAINSIGHT_PROVIDER=grok
# PLAINSIGHT_MODEL=grok-3
# XAI_API_KEY=xai-REPLACE_ME

# --- Option E: Groq (FREE tier, no credit card) ------------------------------
# NOTE: Groq != Grok. Free open-model inference (Llama 3.3 70B etc.), great for
# Stage 1: far stronger than a local 7B and rarely refuses. Key: console.groq.com.
# PLAINSIGHT_PROVIDER=groq
# PLAINSIGHT_MODEL=openai/gpt-oss-120b   # confirm current id at console.groq.com (models change)
# GROQ_API_KEY=gsk_REPLACE_ME

PLAINSIGHT_TEMPERATURE=0.0
# OPENAI_API_KEY=sk-REPLACE_ME
